<Window x:Class="DCx.Desktop.LocalModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCx local models"
        Width="860"
        Height="720"
        MinWidth="640"
        MinHeight="520"
        AutomationProperties.AutomationId="LocalModelsWindow"
        AutomationProperties.Name="DCx local model settings window">
    <DockPanel Margin="20">
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,16,0,0"
                   Padding="10"
                   Text="Loading installed local models."
                   TextWrapping="Wrap"
                   Background="#F3F3F3"
                   AutomationProperties.AutomationId="LocalModelsStatus"
                   AutomationProperties.Name="Loading installed local models."
                   AutomationProperties.LiveSetting="Assertive" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Text="Local models"
                           AutomationProperties.AutomationId="LocalModelsHeading"
                           AutomationProperties.Name="Local models" />
                <TextBlock Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Text="Review models already installed in the local Ollama runtime. This window never downloads, installs, retags, or uploads a model. Only a unique name ending in its matching SHA-256 digest can be selected." />

                <GroupBox Margin="0,16,0,0" Header="Native hardware and resource profile">
                    <TextBox x:Name="HardwareProfileSummary"
                             MinHeight="120"
                             MaxHeight="240"
                             Margin="12,8"
                             Padding="8"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="Reading native Windows hardware and storage capacity."
                             AutomationProperties.AutomationId="LocalHardwareProfile"
                             AutomationProperties.Name="Reading native Windows hardware and storage capacity."
                             AutomationProperties.HelpText="Read-only operating system, processor, memory, application-data storage, graphics-adapter and driver inventory. No external process or network request is used." />
                </GroupBox>

                <GroupBox Margin="0,16,0,0" Header="Current selections">
                    <StackPanel Margin="12,8">
                        <TextBlock x:Name="CurrentVisionText"
                                   Text="Vision: none selected."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="CurrentVisionModel"
                                   AutomationProperties.Name="Vision: none selected." />
                        <TextBlock x:Name="CurrentEmbeddingText"
                                   Margin="0,8,0,0"
                                   Text="Embedding: none selected."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="CurrentEmbeddingModel"
                                   AutomationProperties.Name="Embedding: none selected." />
                        <TextBlock x:Name="CurrentWhisperText"
                                   Margin="0,8,0,0"
                                   Text="Transcription: none selected."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="CurrentWhisperBackend"
                                   AutomationProperties.Name="Transcription: none selected." />
                        <TextBlock x:Name="CurrentFfmpegText"
                                   Margin="0,8,0,0"
                                   Text="Media processor: none selected."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="CurrentFfmpegBackend"
                                   AutomationProperties.Name="Media processor: none selected." />
                    </StackPanel>
                </GroupBox>

                <Button x:Name="OpenBenchmarkReviewButton"
                        Width="230"
                        MinHeight="36"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Content="Open _quality benchmark review"
                        AutomationProperties.AutomationId="OpenBenchmarkReviewButton"
                        AutomationProperties.Name="Open local model quality benchmark review"
                        AutomationProperties.HelpText="Reviews bounded local fixtures and exact quality thresholds. It never installs a model or changes a production selection."
                        Click="OnOpenBenchmarkReviewClick" />

                <GroupBox Margin="0,20,0,0" Header="Audited dependency candidates — review and inert runtime staging">
                    <StackPanel Margin="12,8">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Review immutable P06 candidates and an existing local artifact. An exact Whisper runtime archive can be copied and extracted into private per-user DCx storage only after a separate acknowledgment. DCx does not download, install, pull, execute, register, or select it." />
                        <TextBlock x:Name="DependencyCatalogSummary"
                                   Margin="0,10,0,0"
                                   Text="Loading the built-in dependency catalog."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="DependencyCatalogSummary"
                                   AutomationProperties.Name="Loading the built-in dependency catalog." />
                        <TextBox x:Name="DependencyTransferPreflight"
                                 MinHeight="120"
                                 MaxHeight="240"
                                 Margin="0,10,0,0"
                                 Padding="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Transfer preflight is unavailable until the catalog is authenticated."
                                 AutomationProperties.AutomationId="DependencyTransferPreflight"
                                 AutomationProperties.Name="Transfer preflight is unavailable until the catalog is authenticated."
                                 AutomationProperties.HelpText="Read-only exact transfer-set digest, source identities, byte totals, conservative storage requirement, and observed capacity. It grants no transfer approval." />
                        <ListBox x:Name="DependencyCandidatesList"
                                 MinHeight="120"
                                 Margin="0,10,0,0"
                                 DisplayMemberPath="Display"
                                 AutomationProperties.AutomationId="DependencyCandidatesList"
                                 AutomationProperties.Name="Audited dependency candidates"
                                 AutomationProperties.HelpText="Select a candidate to review its exact source, size, digest, license evidence, and managed layers."
                                 SelectionChanged="OnDependencyCandidateSelectionChanged" />
                        <TextBox x:Name="DependencyCandidateDetails"
                                 MinHeight="120"
                                 MaxHeight="220"
                                 Margin="0,10,0,0"
                                 Padding="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Select a candidate to review its immutable identity."
                                 AutomationProperties.AutomationId="DependencyCandidateDetails"
                                 AutomationProperties.Name="Audited dependency candidate details"
                                 AutomationProperties.HelpText="Read-only exact source, byte count, SHA-256, license evidence, and managed-layer identity." />
                        <Label Margin="0,10,0,0"
                               Padding="0,0,0,4"
                               Target="{Binding ElementName=DependencyArtifactPath}"
                               Content="Optional already-staged artifact _path" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseDependencyArtifactButton"
                                    DockPanel.Dock="Right"
                                    MinWidth="150"
                                    MinHeight="34"
                                    Margin="8,0,0,0"
                                    Content="_9 Browse staged artifact..."
                                    AutomationProperties.AutomationId="BrowseDependencyArtifactButton"
                                    AutomationProperties.Name="Browse for an already-staged dependency artifact"
                                    AutomationProperties.HelpText="Chooses one existing local file. It never downloads, extracts, installs, pulls, or executes it."
                                    Click="OnBrowseDependencyArtifactClick" />
                            <TextBox x:Name="DependencyArtifactPath"
                                     MinHeight="34"
                                     Padding="6"
                                     AutomationProperties.AutomationId="DependencyArtifactPath"
                                     AutomationProperties.Name="Already-staged dependency artifact path"
                                     TextChanged="OnDependencyArtifactPathChanged" />
                        </DockPanel>
                        <Button x:Name="ReviewDependencyArtifactButton"
                                Width="250"
                                MinHeight="36"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Content="_0 Verify staged artifact"
                                IsEnabled="False"
                                AutomationProperties.AutomationId="ReviewDependencyArtifactButton"
                                AutomationProperties.Name="Verify the already-staged dependency artifact"
                                AutomationProperties.HelpText="Takes a read-only lease and verifies exact type, bytes, digest, and managed-layer metadata. It never extracts, installs, pulls, or executes the file."
                                Click="OnReviewDependencyArtifactClick" />
                        <TextBlock x:Name="DependencyArtifactResult"
                                   Margin="0,10,0,0"
                                   Text="No staged artifact has been verified."
                                   TextWrapping="Wrap"
                                   Focusable="True"
                                   AutomationProperties.AutomationId="DependencyArtifactResult"
                                   AutomationProperties.Name="No staged artifact has been verified."
                                   AutomationProperties.LiveSetting="Assertive" />
                        <CheckBox x:Name="DependencyStagingApprovalBox"
                                  Margin="0,12,0,0"
                                  FontWeight="SemiBold"
                                  IsEnabled="False"
                                  Content="I reviewed this exact runtime archive and _approve copying and extracting it into private DCx storage"
                                  AutomationProperties.AutomationId="ApproveDependencyStagingBox"
                                  AutomationProperties.Name="I reviewed this exact runtime archive and approve copying and extracting it into private DCx storage"
                                  AutomationProperties.HelpText="Unchecked by default. This permits inert per-user staging only, not installation, registration, execution, or model selection."
                                  Checked="OnDependencyStagingApprovalChanged"
                                  Unchecked="OnDependencyStagingApprovalChanged" />
                        <Button x:Name="StageDependencyRuntimeButton"
                                Width="260"
                                MinHeight="36"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Content="_Stage verified runtime inertly"
                                IsEnabled="False"
                                AutomationProperties.AutomationId="StageDependencyRuntimeButton"
                                AutomationProperties.Name="Stage the verified Whisper runtime inertly"
                                AutomationProperties.HelpText="Reauthenticates the selected archive, creates a digest-bound private copy with a minimized receipt, and does not install, register, execute, or select it."
                                Click="OnStageDependencyRuntimeClick" />
                    </StackPanel>
                </GroupBox>

                <Button x:Name="RefreshButton"
                        Width="180"
                        MinHeight="36"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Content="_Refresh installed models"
                        AutomationProperties.AutomationId="RefreshLocalModelsButton"
                        AutomationProperties.Name="Refresh installed local models"
                        AutomationProperties.HelpText="Reads model identity and capability metadata from the loopback Ollama runtime only."
                        Click="OnRefreshClick" />

                <TextBlock Margin="0,14,0,6"
                           FontWeight="SemiBold"
                           Text="Installed model identities" />
                <ListBox x:Name="ModelsList"
                         MinHeight="180"
                         DisplayMemberPath="Display"
                         AutomationProperties.AutomationId="InstalledLocalModelsList"
                         AutomationProperties.Name="Installed local model identities"
                         AutomationProperties.HelpText="Select an entry to review its full identity, capabilities, size, and license."
                         SelectionChanged="OnModelSelectionChanged" />

                <GroupBox Margin="0,14,0,0" Header="Selected model review">
                    <TextBlock x:Name="ModelDetailsText"
                               Margin="12,8"
                               Text="Select an installed model to review it."
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="LocalModelDetails"
                               AutomationProperties.Name="Select an installed model to review it." />
                </GroupBox>

                <GroupBox Margin="0,14,0,0" Header="Complete installed-model license text">
                    <TextBox x:Name="ModelLicenseText"
                             MinHeight="100"
                             MaxHeight="180"
                             Margin="12,8"
                             Padding="8"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="Select an installed model to inspect its complete license text."
                             AutomationProperties.AutomationId="LocalModelLicenseText"
                             AutomationProperties.Name="Complete installed-model license text"
                             AutomationProperties.HelpText="Read-only complete license text returned by the loopback Ollama runtime for the selected model." />
                </GroupBox>

                <CheckBox x:Name="ApprovalBox"
                          Margin="0,16,0,0"
                          FontWeight="SemiBold"
                          Content="I reviewed this exact model digest and license and a_pprove selecting it"
                          AutomationProperties.AutomationId="ApproveLocalModelSelectionBox"
                          AutomationProperties.Name="I reviewed this exact model digest and license and approve selecting it"
                          AutomationProperties.HelpText="Unchecked by default and required for each new vision or embedding selection." />

                <GroupBox Margin="0,20,0,0" Header="Already-installed Whisper transcription backend">
                    <StackPanel Margin="12,8">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Register an existing local Whisper command-line executable, model, and their complete license files. DCx does not download or install them. Registration pins all four file identities, but does not prove publisher authenticity, model accuracy, or suitability." />

                        <Label Margin="0,10,0,0"
                               Padding="0,0,0,4"
                               Target="{Binding ElementName=WhisperExecutablePath}"
                               Content="Whisper e_xecutable (.exe)" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseWhisperExecutableButton"
                                    DockPanel.Dock="Right"
                                    MinWidth="100"
                                    MinHeight="34"
                                    Margin="8,0,0,0"
                                    Content="_Browse..."
                                    AutomationProperties.AutomationId="BrowseWhisperExecutableButton"
                                    AutomationProperties.Name="Browse for already-installed Whisper executable"
                                    Click="OnBrowseWhisperExecutableClick" />
                            <TextBox x:Name="WhisperExecutablePath"
                                     MinHeight="34"
                                     Padding="6"
                                     AutomationProperties.AutomationId="WhisperExecutablePath"
                                     AutomationProperties.Name="Already-installed Whisper executable path"
                                     TextChanged="OnWhisperInputChanged" />
                        </DockPanel>

                        <Label Margin="0,10,0,0"
                               Padding="0,0,0,4"
                               Target="{Binding ElementName=WhisperModelPath}"
                               Content="Whisper _model (.bin or .gguf)" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseWhisperModelButton"
                                    DockPanel.Dock="Right"
                                    MinWidth="100"
                                    MinHeight="34"
                                    Margin="8,0,0,0"
                                    Content="Br_owse..."
                                    AutomationProperties.AutomationId="BrowseWhisperModelButton"
                                    AutomationProperties.Name="Browse for already-installed Whisper model"
                                    Click="OnBrowseWhisperModelClick" />
                            <TextBox x:Name="WhisperModelPath"
                                     MinHeight="34"
                                     Padding="6"
                                     AutomationProperties.AutomationId="WhisperModelPath"
                                     AutomationProperties.Name="Already-installed Whisper model path"
                                     TextChanged="OnWhisperInputChanged" />
                        </DockPanel>

                        <Label Margin="0,10,0,0"
                               Padding="0,0,0,4"
                               Target="{Binding ElementName=WhisperRuntimeLicensePath}"
                               Content="Runtime _license file" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseWhisperRuntimeLicenseButton"
                                    DockPanel.Dock="Right"
                                    MinWidth="100"
                                    MinHeight="34"
                                    Margin="8,0,0,0"
                                    Content="Browse r_untime..."
                                    AutomationProperties.AutomationId="BrowseWhisperRuntimeLicenseButton"
                                    AutomationProperties.Name="Browse for Whisper runtime license file"
                                    Click="OnBrowseWhisperRuntimeLicenseClick" />
                            <TextBox x:Name="WhisperRuntimeLicensePath"
                                     MinHeight="34"
                                     Padding="6"
                                     AutomationProperties.AutomationId="WhisperRuntimeLicensePath"
                                     AutomationProperties.Name="Whisper runtime license path"
                                     TextChanged="OnWhisperInputChanged" />
                        </DockPanel>

                        <Label Margin="0,10,0,0"
                               Padding="0,0,0,4"
                               Target="{Binding ElementName=WhisperModelLicensePath}"
                               Content="Model l_icense file" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseWhisperModelLicenseButton"
                                    DockPanel.Dock="Right"
                                    MinWidth="100"
                                    MinHeight="34"
                                    Margin="8,0,0,0"
                                    Content="Browse mo_del..."
                                    AutomationProperties.AutomationId="BrowseWhisperModelLicenseButton"
                                    AutomationProperties.Name="Browse for Whisper model license file"
                                    Click="OnBrowseWhisperModelLicenseClick" />
                            <TextBox x:Name="WhisperModelLicensePath"
                                     MinHeight="34"
                                     Padding="6"
                                     AutomationProperties.AutomationId="WhisperModelLicensePath"
                                     AutomationProperties.Name="Whisper model license path"
                                     TextChanged="OnWhisperInputChanged" />
                        </DockPanel>

                        <Button x:Name="ReviewWhisperBackendButton"
                                Width="200"
                                MinHeight="36"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Content="Review exact _files"
                                AutomationProperties.AutomationId="ReviewWhisperBackendButton"
                                AutomationProperties.Name="Review exact Whisper backend files"
                                AutomationProperties.HelpText="Reads and hashes the four local files. Nothing is downloaded, installed, or uploaded."
                                Click="OnReviewWhisperBackendClick" />

                        <TextBlock x:Name="WhisperBackendDetails"
                                   Margin="0,12,0,0"
                                   Text="Enter four existing local file paths, then review them."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="WhisperBackendDetails"
                                   AutomationProperties.Name="Enter four existing local file paths, then review them." />

                        <TextBox x:Name="WhisperLicenseText"
                                 MinHeight="120"
                                 MaxHeight="240"
                                 Margin="0,12,0,0"
                                 Padding="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Complete runtime and model license text will appear after review."
                                 AutomationProperties.AutomationId="WhisperLicenseText"
                                 AutomationProperties.Name="Complete Whisper runtime and model license text" />

                        <CheckBox x:Name="WhisperApprovalBox"
                                  Margin="0,14,0,0"
                                  FontWeight="SemiBold"
                                  IsEnabled="False"
                                  Content="I reviewed these exact four file digests and both complete licenses and _approve registration"
                                  AutomationProperties.AutomationId="ApproveWhisperBackendBox"
                                  AutomationProperties.Name="I reviewed these exact four file digests and both complete licenses and approve registration"
                                  AutomationProperties.HelpText="Unchecked by default. Required after every review or file-path change." />

                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="SaveWhisperBackendButton"
                                    MinWidth="180"
                                    MinHeight="36"
                                    Margin="0,0,10,0"
                                    IsEnabled="False"
                                    Content="_Save registration"
                                    AutomationProperties.AutomationId="SaveWhisperBackendButton"
                                    AutomationProperties.Name="Save approved Whisper backend registration"
                                    Click="OnSaveWhisperBackendClick" />
                            <Button x:Name="ClearWhisperBackendButton"
                                    MinWidth="180"
                                    MinHeight="36"
                                    Content="Clear regis_tration"
                                    AutomationProperties.AutomationId="ClearWhisperBackendButton"
                                    AutomationProperties.Name="Clear Whisper backend registration"
                                    AutomationProperties.HelpText="Clears only the DCx registration. It does not delete or uninstall any file."
                                    Click="OnClearWhisperBackendClick" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,20,0,0" Header="Already-installed FFmpeg media processor">
                    <StackPanel Margin="12,8">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Register an existing local FFmpeg executable and its complete license. DCx does not download, install, or bundle FFmpeg. Review includes real Windows signature status. A digest match does not establish publisher authenticity, legal distribution clearance, or media safety." />
                        <Label Margin="0,10,0,0" Padding="0,0,0,4"
                               Target="{Binding ElementName=FfmpegExecutablePath}"
                               Content="_1 FFmpeg executable (.exe)" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseFfmpegExecutableButton" DockPanel.Dock="Right"
                                    MinWidth="100" MinHeight="34" Margin="8,0,0,0"
                                    Content="_2 Browse FFmpeg..."
                                    AutomationProperties.AutomationId="BrowseFfmpegExecutableButton"
                                    AutomationProperties.Name="Browse for already-installed FFmpeg executable"
                                    Click="OnBrowseFfmpegExecutableClick" />
                            <TextBox x:Name="FfmpegExecutablePath" MinHeight="34" Padding="6"
                                     AutomationProperties.AutomationId="FfmpegExecutablePath"
                                     AutomationProperties.Name="Already-installed FFmpeg executable path"
                                     TextChanged="OnFfmpegInputChanged" />
                        </DockPanel>
                        <Label Margin="0,10,0,0" Padding="0,0,0,4"
                               Target="{Binding ElementName=FfmpegLicensePath}"
                               Content="_3 FFmpeg license file" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseFfmpegLicenseButton" DockPanel.Dock="Right"
                                    MinWidth="100" MinHeight="34" Margin="8,0,0,0"
                                    Content="_4 Browse FFmpeg license..."
                                    AutomationProperties.AutomationId="BrowseFfmpegLicenseButton"
                                    AutomationProperties.Name="Browse for FFmpeg license file"
                                    Click="OnBrowseFfmpegLicenseClick" />
                            <TextBox x:Name="FfmpegLicensePath" MinHeight="34" Padding="6"
                                     AutomationProperties.AutomationId="FfmpegLicensePath"
                                     AutomationProperties.Name="FFmpeg license path"
                                     TextChanged="OnFfmpegInputChanged" />
                        </DockPanel>
                        <Button x:Name="ReviewFfmpegBackendButton" Width="210" MinHeight="36"
                                Margin="0,14,0,0" HorizontalAlignment="Left"
                                Content="_5 Review media processor"
                                AutomationProperties.AutomationId="ReviewFfmpegBackendButton"
                                AutomationProperties.Name="Review exact FFmpeg executable, license, and Windows signature status"
                                Click="OnReviewFfmpegBackendClick" />
                        <TextBlock x:Name="FfmpegBackendDetails" Margin="0,12,0,0"
                                   Text="Enter an existing executable and license path, then review them."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="FfmpegBackendDetails"
                                   AutomationProperties.Name="Enter an existing executable and license path, then review them." />
                        <TextBox x:Name="FfmpegLicenseText" MinHeight="120" MaxHeight="240"
                                 Margin="0,12,0,0" Padding="8" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="Complete FFmpeg license text will appear after review."
                                 AutomationProperties.AutomationId="FfmpegLicenseText"
                                 AutomationProperties.Name="Complete FFmpeg license text" />
                        <CheckBox x:Name="FfmpegApprovalBox" Margin="0,14,0,0" FontWeight="SemiBold"
                                  IsEnabled="False"
                                  Content="_6 I reviewed the exact digests, complete license, and signature status and approve this registration"
                                  AutomationProperties.AutomationId="ApproveFfmpegBackendBox"
                                  AutomationProperties.Name="I reviewed the exact FFmpeg digests, complete license, and signature status and approve this registration" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="SaveFfmpegBackendButton" MinWidth="180" MinHeight="36"
                                    Margin="0,0,10,0" IsEnabled="False" Content="_7 Save media processor"
                                    AutomationProperties.AutomationId="SaveFfmpegBackendButton"
                                    AutomationProperties.Name="Save approved FFmpeg registration"
                                    Click="OnSaveFfmpegBackendClick" />
                            <Button x:Name="ClearFfmpegBackendButton" MinWidth="180" MinHeight="36"
                                    Content="_8 Clear media processor"
                                    AutomationProperties.AutomationId="ClearFfmpegBackendButton"
                                    AutomationProperties.Name="Clear FFmpeg registration"
                                    AutomationProperties.HelpText="Clears only the DCx registration and never deletes FFmpeg or its license."
                                    Click="OnClearFfmpegBackendClick" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="UseVisionButton"
                            MinWidth="150"
                            MinHeight="36"
                            Margin="0,0,10,10"
                            Content="Use for _vision"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="UseLocalModelForVisionButton"
                            AutomationProperties.Name="Use selected local model for vision"
                            Click="OnUseVisionClick" />
                    <Button x:Name="UseEmbeddingButton"
                            MinWidth="170"
                            MinHeight="36"
                            Margin="0,0,10,10"
                            Content="Use for _embeddings"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="UseLocalModelForEmbeddingsButton"
                            AutomationProperties.Name="Use selected local model for embeddings"
                            Click="OnUseEmbeddingClick" />
                    <Button MinWidth="140"
                            MinHeight="36"
                            Margin="0,0,10,10"
                            Content="Clear visio_n"
                            AutomationProperties.AutomationId="ClearLocalVisionModelButton"
                            AutomationProperties.Name="Clear selected local vision model"
                            Click="OnClearVisionClick" />
                    <Button MinWidth="160"
                            MinHeight="36"
                            Margin="0,0,10,10"
                            Content="Clear embeddin_gs"
                            AutomationProperties.AutomationId="ClearLocalEmbeddingModelButton"
                            AutomationProperties.Name="Clear selected local embedding model"
                            Click="OnClearEmbeddingClick" />
                    <Button MinWidth="100"
                            MinHeight="36"
                            Margin="0,0,0,10"
                            Content="_Close"
                            IsCancel="True"
                            AutomationProperties.AutomationId="CloseLocalModelsButton"
                            AutomationProperties.Name="Close local model settings"
                            Click="OnCloseClick" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
