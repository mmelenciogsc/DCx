<Window x:Class="DCx.Desktop.ScannedPdfWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Scanned PDF accessibility wizard — DCx"
        Width="720" Height="680" MinWidth="580" MinHeight="520"
        AutomationProperties.AutomationId="ScannedPdfWizardWindow"
        AutomationProperties.Name="Scanned PDF accessibility wizard">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Scanned PDF accessibility wizard" />
            <TextBlock x:Name="PdfPathText" Margin="0,6,0,10" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="PdfPathText" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="OCR creates ordered text blocks with normalized page geometry. Review the result before exporting. HTML is editable only for blocks explicitly marked as form fields; scanned text remains semantic text." />
            <Button x:Name="RecognizePdfButton" Width="180" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Content="Recognize document"
                    AutomationProperties.AutomationId="RecognizePdfButton"
                    AutomationProperties.Name="Recognize scanned PDF with Windows OCR"
                    Click="OnRecognizeClick" />
            <TextBlock x:Name="WizardStatusText" Margin="0,0,0,12" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Ready to recognize."
                       AutomationProperties.AutomationId="WizardStatusText"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock FontWeight="SemiBold" Text="Optional semantic repair for selected block" />
            <WrapPanel Margin="0,4,0,10">
                <ComboBox x:Name="RepairRoleBox" MinWidth="150" Margin="0,0,8,0"
                          AutomationProperties.AutomationId="RepairRoleBox"
                          AutomationProperties.Name="Semantic role for selected OCR block" />
                <TextBox x:Name="RepairLabelBox" MinWidth="220" Margin="0,0,8,0" Padding="4"
                         AutomationProperties.AutomationId="RepairLabelBox"
                         AutomationProperties.Name="Accessible label for selected OCR block" />
                <Button x:Name="ApplyRepairButton" MinWidth="130" Content="Apply repair" IsEnabled="False"
                        AutomationProperties.AutomationId="ApplyRepairButton" Click="OnApplyRepairClick" />
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="ExportHtmlButton" MinWidth="160" Margin="0,0,8,0" Content="Export semantic HTML"
                        IsEnabled="False" AutomationProperties.AutomationId="ExportHtmlButton"
                        Click="OnExportHtmlClick" />
                <Button x:Name="ExportDocxButton" MinWidth="160" Margin="0,0,8,0" Content="Export structured DOCX"
                        IsEnabled="False" AutomationProperties.AutomationId="ExportDocxButton"
                        Click="OnExportDocxClick" />
                <Button x:Name="ExportPdfButton" MinWidth="180" Content="_Export flattened PDF"
                        IsEnabled="False" AutomationProperties.AutomationId="ExportPdfButton"
                        AutomationProperties.Name="Export tagged flattened PDF"
                        AutomationProperties.HelpText="Creates a non-editable PDF with the source-page raster plus reviewed OCR text and page geometry. Human accessibility review is still required."
                        Click="OnExportPdfClick" />
            </WrapPanel>
            <wv2:WebView2 x:Name="PdfExportWebView" Width="1" Height="1"
                         Focusable="False" IsHitTestVisible="False" />
        </StackPanel>
        <ListBox x:Name="OcrBlocksList" AutomationProperties.AutomationId="OcrBlocksList"
                 AutomationProperties.Name="OCR blocks in page reading order"
                 SelectionChanged="OnBlockSelectionChanged" />
    </DockPanel>
</Window>
