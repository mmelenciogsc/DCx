<Window x:Class="DCx.Desktop.ReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCx release readiness"
        Width="900"
        Height="820"
        MinWidth="700"
        MinHeight="560"
        AutomationProperties.AutomationId="ReadinessWindow"
        AutomationProperties.Name="DCx release readiness window">
    <ScrollViewer Margin="20"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel>
            <TextBlock x:Name="Heading"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Focusable="True"
                       Text="DCx release readiness"
                       AutomationProperties.AutomationId="ReadinessHeading"
                       AutomationProperties.Name="DCx release readiness" />
            <Border Margin="0,12,0,0"
                    Padding="12"
                    Background="#FFF4CE"
                    BorderBrush="#8A6D00"
                    BorderThickness="1">
                <TextBlock x:Name="DecisionText"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="Loading readiness decision."
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ReadinessDecision"
                           AutomationProperties.Name="Loading readiness decision."
                           AutomationProperties.LiveSetting="Assertive" />
            </Border>
            <TextBlock Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Text="The release decision and evidence are read-only. The local privacy controls below cannot approve production, enroll a pilot, collect an event by themselves, publish content, or initiate payments." />
            <TextBlock x:Name="ConsentText"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       Text="Metric consent status is loading."
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ReadinessConsentStatus"
                       AutomationProperties.Name="Metric consent status is loading."
                       AutomationProperties.LiveSetting="Polite" />
            <GroupBox Margin="0,10,0,0"
                      Header="Local aggregate metric privacy controls"
                      AutomationProperties.AutomationId="MetricPrivacyControls"
                      AutomationProperties.Name="Local aggregate metric privacy controls">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap"
                               Text="Notice version 1. If enabled, DCx may store only the twelve listed daily aggregate metrics and their reviewed closed dimensions on this device. Prompts, responses, URLs, paths, keystrokes, screen content, account identifiers and user identifiers are excluded. No product event source or network transport is connected. You can stop and purge retained aggregates at any time." />
                    <CheckBox x:Name="MetricOptInApprovalBox"
                              Margin="0,10,0,0"
                              Content="_I consent to local aggregate metric recording under notice version 1"
                              AutomationProperties.AutomationId="MetricOptInApproval"
                              AutomationProperties.Name="I consent to local aggregate metric recording under notice version 1, initially unchecked"
                              Checked="OnMetricApprovalChanged"
                              Unchecked="OnMetricApprovalChanged" />
                    <Button x:Name="EnableMetricRecordingButton"
                            Width="250"
                            MinHeight="36"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Content="_Enable local aggregate recording"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="EnableMetricRecording"
                            AutomationProperties.Name="Enable local aggregate recording"
                            Click="OnEnableMetricRecordingClick" />
                    <CheckBox x:Name="MetricOptOutApprovalBox"
                              Margin="0,12,0,0"
                              Content="I _approve stopping recording and permanently deleting retained local aggregates"
                              AutomationProperties.AutomationId="MetricOptOutApproval"
                              AutomationProperties.Name="I approve stopping recording and permanently deleting retained local aggregates, initially unchecked"
                              Checked="OnMetricApprovalChanged"
                              Unchecked="OnMetricApprovalChanged" />
                    <Button x:Name="StopAndPurgeMetricsButton"
                            Width="300"
                            MinHeight="36"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Content="_Stop recording and purge local aggregates"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="StopAndPurgeMetrics"
                            AutomationProperties.Name="Stop recording and purge local aggregates"
                            Click="OnStopAndPurgeMetricsClick" />
                    <TextBlock x:Name="ConsentActionStatus"
                               Margin="0,10,0,0"
                               Focusable="True"
                               Text="No local metric privacy change is pending."
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="MetricConsentActionStatus"
                               AutomationProperties.Name="No local metric privacy change is pending."
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </GroupBox>
            <GroupBox Margin="0,10,0,0"
                      Header="Local pilot administration preview"
                      AutomationProperties.AutomationId="PilotAdministrationPreview"
                      AutomationProperties.Name="Local pilot administration preview">
                <StackPanel Margin="10">
                    <TextBlock x:Name="PilotAdministrationStatus"
                               Text="Local pilot administration status is loading."
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               AutomationProperties.AutomationId="PilotAdministrationStatus"
                               AutomationProperties.Name="Local pilot administration status is loading." />
                    <TextBlock x:Name="PilotAggregateStatus"
                               Margin="0,8,0,0"
                               Text="Retained aggregate summary is loading."
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PilotAggregateStatus"
                               AutomationProperties.Name="Retained aggregate summary is loading." />
                    <ListBox x:Name="PilotAggregatesList"
                             Height="90"
                             Margin="0,8,0,0"
                             AutomationProperties.AutomationId="PilotAggregates"
                             AutomationProperties.Name="Retained local aggregate metric buckets from the last 30 UTC days" />
                    <Button x:Name="RunIncidentDryRunButton"
                            Width="250"
                            MinHeight="36"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Content="Run local incident stop _drill"
                            AutomationProperties.AutomationId="RunIncidentDryRun"
                            AutomationProperties.Name="Run local incident stop drill"
                            AutomationProperties.HelpText="Evaluates seven predefined incident stop scenarios without changing state or contacting any service."
                            Click="OnRunIncidentDryRunClick" />
                    <TextBlock x:Name="IncidentDryRunStatus"
                               Margin="0,8,0,0"
                               Focusable="True"
                               Text="No local incident stop drill has run."
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="IncidentDryRunStatus"
                               AutomationProperties.Name="No local incident stop drill has run."
                               AutomationProperties.LiveSetting="Assertive" />
                    <ListBox x:Name="IncidentDryRunResults"
                             Height="120"
                             Margin="0,8,0,0"
                             AutomationProperties.AutomationId="IncidentDryRunResults"
                             AutomationProperties.Name="Local incident stop drill results" />
                </StackPanel>
            </GroupBox>
            <TextBlock x:Name="SummaryText"
                       Margin="0,8,0,0"
                       Text="Readiness counts are loading."
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ReadinessSummary"
                       AutomationProperties.Name="Readiness counts are loading." />
            <Button x:Name="RefreshButton"
                    Width="170"
                    MinHeight="36"
                    Margin="0,12,0,12"
                    HorizontalAlignment="Left"
                    Content="_Refresh readiness"
                    AutomationProperties.AutomationId="ReadinessRefresh"
                    AutomationProperties.Name="Refresh readiness"
                    Click="OnRefreshClick" />
            <Grid Height="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Blocking critical and major issues" Margin="0,0,10,0">
                <ListBox x:Name="BlockersList"
                         Margin="8"
                         AutomationProperties.AutomationId="ReadinessBlockers"
                         AutomationProperties.Name="Blocking critical and major readiness issues" />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Privacy-reviewed metric definitions" Margin="10,0,0,0">
                <ListBox x:Name="MetricsList"
                         Margin="8"
                         AutomationProperties.AutomationId="ReadinessMetrics"
                         AutomationProperties.Name="Privacy-reviewed pilot metric definitions" />
            </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
