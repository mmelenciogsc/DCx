<Window x:Class="DCx.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCx / Agentic Browser"
        Width="1360"
        Height="860"
        MinWidth="900"
        MinHeight="600"
        AutomationProperties.Name="DCx Agentic Browser main window"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseDown="OnPreviewMouseDown">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        MinWidth="52"
                        Margin="0,0,6,0"
                        Content="Back"
                        IsEnabled="False"
                        AutomationProperties.AutomationId="BackButton"
                        AutomationProperties.Name="Go back"
                        Click="OnBackClick" />
                <Button x:Name="ForwardButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        MinWidth="62"
                        Margin="0,0,6,0"
                        Content="Forward"
                        IsEnabled="False"
                        AutomationProperties.AutomationId="ForwardButton"
                        AutomationProperties.Name="Go forward"
                        Click="OnForwardClick" />
                <Button x:Name="ReloadButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="62"
                        Margin="0,0,8,0"
                        Content="Reload"
                        IsEnabled="False"
                        AutomationProperties.AutomationId="ReloadButton"
                        AutomationProperties.Name="Reload page"
                        Click="OnReloadClick" />
                <TextBox x:Name="AddressBox"
                         Grid.Row="0"
                         Grid.Column="3"
                         MinHeight="32"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="AddressBox"
                         AutomationProperties.Name="Web address"
                         AutomationProperties.HelpText="Enter an HTTP or HTTPS address. Press Control L from anywhere to focus this field."
                         KeyDown="OnAddressKeyDown" />
                <Button x:Name="GoButton"
                        Grid.Row="0"
                        Grid.Column="4"
                        MinWidth="64"
                        Margin="8,0,0,0"
                        Content="Go"
                        AutomationProperties.AutomationId="GoButton"
                        AutomationProperties.Name="Navigate to web address"
                        Click="OnGoClick" />
                <Button x:Name="NewTabButton"
                        Grid.Row="0"
                        Grid.Column="5"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        Content="New tab"
                        AutomationProperties.AutomationId="NewTabButton"
                        AutomationProperties.Name="Open new tab"
                        AutomationProperties.HelpText="Opens a tab in the selected browser profile. Shortcut Control T."
                        Click="OnNewTabClick" />

                <WrapPanel Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="6"
                           Margin="0,8,0,0"
                           Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="New-tab profile:" />
                    <ComboBox x:Name="ProfilesBox"
                              MinWidth="110"
                              Margin="0,0,8,0"
                              AutomationProperties.AutomationId="ProfilesBox"
                              AutomationProperties.Name="Browser profile for new tabs"
                              SelectionChanged="OnProfileSelectionChanged" />
                    <Button x:Name="BookmarkButton"
                            Margin="0,0,6,0"
                            Content="Bookmark"
                            AutomationProperties.AutomationId="BookmarkButton"
                            AutomationProperties.Name="Bookmark current page"
                            AutomationProperties.HelpText="Shortcut Control D."
                            Click="OnBookmarkClick" />
                    <Button Margin="0,0,6,0"
                            Content="Bookmarks"
                            AutomationProperties.AutomationId="BookmarksButton"
                            AutomationProperties.Name="Show bookmarks"
                            Click="OnShowBookmarksClick" />
                    <Button Margin="0,0,6,0"
                            Content="History"
                            AutomationProperties.AutomationId="HistoryButton"
                            AutomationProperties.Name="Show history"
                            AutomationProperties.HelpText="Shortcut Control H."
                            Click="OnShowHistoryClick" />
                    <Button Margin="0,0,6,0"
                            Content="Downloads"
                            AutomationProperties.AutomationId="DownloadsButton"
                            AutomationProperties.Name="Show downloads"
                            AutomationProperties.HelpText="Shortcut Control J."
                            Click="OnShowDownloadsClick" />
                    <Button x:Name="AgentDrawerButton"
                            MinWidth="104"
                            Margin="0,0,6,0"
                            Content="Agent"
                            AutomationProperties.AutomationId="AgentDrawerButton"
                            AutomationProperties.Name="Open agent controls"
                            Click="OnAgentDrawerClick" />
                    <Button x:Name="WindowsAppButton"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Content="Windows app"
                            AutomationProperties.AutomationId="WindowsAppButton"
                            AutomationProperties.Name="Open Windows application controls"
                            Click="OnWindowsAppClick" />
                    <Button x:Name="OpenAiButton"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Content="OpenAI"
                            AutomationProperties.AutomationId="OpenAiButton"
                            AutomationProperties.Name="Open OpenAI and local Codex settings"
                            Click="OnOpenAiClick" />
                    <Button x:Name="LocalModelsButton"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Content="Local models"
                            AutomationProperties.AutomationId="LocalModelsButton"
                            AutomationProperties.Name="Open local model settings"
                            AutomationProperties.HelpText="Review and select already-installed digest-bound local models. No model is downloaded automatically."
                            Click="OnLocalModelsClick" />
                    <Button x:Name="ContentViewerButton"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Content="Files/media"
                            AutomationProperties.AutomationId="ContentViewerButton"
                            AutomationProperties.Name="Open files and media viewer"
                            Click="OnContentViewerClick" />
                    <Button x:Name="ContributionsButton"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Content="Contributions"
                            AutomationProperties.AutomationId="ContributionsButton"
                            AutomationProperties.Name="Open private contribution review"
                            Click="OnContributionsClick" />
                    <Button x:Name="CareRecipientsButton"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Content="CARE recipients"
                            AutomationProperties.AutomationId="CareRecipientsButton"
                            AutomationProperties.Name="Open CARE payout recipient snapshot approval"
                            AutomationProperties.HelpText="Prepare or revoke protected owner-approved recipient snapshots. This does not contact PayPal or authorize a payout."
                            Click="OnCareRecipientsClick" />
                    <Button x:Name="CareOperationsButton"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Content="CARE operations"
                            AutomationProperties.AutomationId="CareOperationsButton"
                            AutomationProperties.Name="Open CARE verified-event operations"
                            AutomationProperties.HelpText="Review aggregate verified-event queue health. Processing is unavailable unless an explicitly authorized source provides it."
                            Click="OnCareOperationsClick" />
                    <Button MinWidth="100"
                            Margin="0,0,6,0"
                            Content="Recovery"
                            AutomationProperties.AutomationId="RecoveryButton"
                            AutomationProperties.Name="Open backup and recovery"
                            AutomationProperties.HelpText="Opens a separate recovery window. Close the main DCx window before running backup or restore."
                            Click="OnRecoveryClick" />
                    <Button MinWidth="100"
                            Margin="0,0,6,0"
                            Content="Diagnostics"
                            AutomationProperties.AutomationId="CrashDiagnosticsButton"
                            AutomationProperties.Name="Open privacy and crash diagnostics"
                            AutomationProperties.HelpText="Review or change default-off local crash diagnostics and delete retained reports."
                            Click="OnCrashDiagnosticsClick" />
                    <Button MinWidth="100"
                            Content="Readiness"
                            AutomationProperties.AutomationId="ReadinessButton"
                            AutomationProperties.Name="Open release readiness dashboard"
                            AutomationProperties.HelpText="Opens the read-only release blocker and metric dashboard."
                            Click="OnReadinessClick" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="8,5">
            <TextBlock x:Name="StatusText"
                       Text="Starting DCx."
                       AutomationProperties.AutomationId="StatusText"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Border x:Name="UtilityPanel"
                DockPanel.Dock="Bottom"
                Height="190"
                Padding="8"
                Background="White"
                BorderBrush="#808080"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="UtilityPanel"
                AutomationProperties.Name="Browser information panel">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Width="80"
                        Height="30"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Content="Close"
                        AutomationProperties.Name="Close browser information panel"
                        Click="OnCloseUtilityPanelClick" />
                <TabControl x:Name="UtilityTabs"
                            AutomationProperties.AutomationId="UtilityTabs"
                            AutomationProperties.Name="Bookmarks history and downloads">
                    <TabItem Header="Bookmarks" AutomationProperties.Name="Bookmarks">
                        <ListBox x:Name="BookmarksList"
                                 AutomationProperties.AutomationId="BookmarksList"
                                 AutomationProperties.Name="Saved bookmarks"
                                 MouseDoubleClick="OnBookmarksOpen"
                                 KeyDown="OnBookmarksKeyDown" />
                    </TabItem>
                    <TabItem Header="History" AutomationProperties.Name="History">
                        <ListBox x:Name="HistoryList"
                                 AutomationProperties.AutomationId="HistoryList"
                                 AutomationProperties.Name="Browsing history"
                                 MouseDoubleClick="OnHistoryOpen"
                                 KeyDown="OnHistoryKeyDown" />
                    </TabItem>
                    <TabItem Header="Downloads" AutomationProperties.Name="Downloads">
                        <ListBox x:Name="DownloadsList"
                                 AutomationProperties.AutomationId="DownloadsList"
                                 AutomationProperties.Name="Downloads" />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="WebView2PrerequisitePanel"
                      Grid.ColumnSpan="2"
                      Panel.ZIndex="10"
                      Margin="32"
                      Padding="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="760"
                      Background="White"
                      BorderBrush="#606060"
                      BorderThickness="2"
                      Header="Browser prerequisite"
                      Visibility="Collapsed"
                      AutomationProperties.AutomationId="WebView2PrerequisitePanel"
                      AutomationProperties.Name="WebView2 Runtime required"
                      AutomationProperties.LiveSetting="Assertive">
                <StackPanel Margin="8">
                    <TextBlock x:Name="WebView2PrerequisiteHeading"
                               Margin="0,0,0,12"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Focusable="True"
                               Text="WebView2 Runtime required"
                               AutomationProperties.AutomationId="WebView2PrerequisiteHeading"
                               AutomationProperties.Name="WebView2 Runtime required" />
                    <TextBlock x:Name="WebView2PrerequisiteExplanation"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="WebView2PrerequisiteExplanation"
                               Text="DCx cannot open web pages because Microsoft Edge WebView2 Runtime is unavailable. No download or installation was attempted. Use another browser to visit the official Microsoft page. Install the Evergreen Runtime only after you approve it. Then return here and choose Recheck." />
                    <Label Padding="0"
                           Target="{Binding ElementName=WebView2DownloadAddress}"
                           Content="Official Microsoft WebView2 download address" />
                    <TextBox x:Name="WebView2DownloadAddress"
                             Margin="0,4,0,12"
                             Padding="6"
                             IsReadOnly="True"
                             Text="https://developer.microsoft.com/microsoft-edge/webview2/"
                             AutomationProperties.AutomationId="WebView2DownloadAddress"
                             AutomationProperties.Name="Official Microsoft WebView2 download address"
                             AutomationProperties.HelpText="Read-only address. DCx does not open or download anything automatically." />
                    <WrapPanel>
                        <Button MinWidth="190"
                                Margin="0,0,8,0"
                                Content="Copy official address"
                                AutomationProperties.AutomationId="CopyWebView2DownloadAddressButton"
                                AutomationProperties.Name="Copy official Microsoft WebView2 download address"
                                Click="OnCopyWebView2DownloadAddressClick" />
                        <Button x:Name="RecheckWebView2RuntimeButton"
                                MinWidth="100"
                                Content="Recheck"
                                AutomationProperties.AutomationId="RecheckWebView2RuntimeButton"
                                AutomationProperties.Name="Recheck WebView2 Runtime availability"
                                AutomationProperties.HelpText="Checks only this device. It does not download or install software."
                                Click="OnRecheckWebView2RuntimeClick" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <TabControl x:Name="BrowserTabs"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="BrowserTabs"
                        AutomationProperties.Name="Browser tabs"
                        SelectionChanged="OnBrowserTabSelectionChanged" />

            <GroupBox x:Name="AgentDrawer"
                      Grid.Column="1"
                      Width="320"
                      Header="Agent controls"
                      Padding="16"
                      Background="#F8F8F8"
                      BorderBrush="#808080"
                      BorderThickness="1,0,0,0"
                      Visibility="Collapsed"
                      AutomationProperties.AutomationId="AgentDrawer"
                      AutomationProperties.Name="Agent controls">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="CloseAgentDrawerButton"
                                MinWidth="64"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Right"
                                Content="Close"
                                AutomationProperties.Name="Close agent controls"
                                Click="OnAgentDrawerClick" />
                        <TextBlock x:Name="AgentControlModeText"
                                   Margin="0,0,0,12"
                                   FontWeight="SemiBold"
                                   Text="Control: User"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AgentControlModeText"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Text="This deterministic handoff demo works only with a loopback test page. Every agent action requires the approved tab, origin, page generation and active lease." />
                        <Label Target="{Binding ElementName=AgentTargetBox}"
                               Padding="0"
                               Content="Controlled demo URL" />
                        <TextBox x:Name="AgentTargetBox"
                                 Margin="0,4,0,8"
                                 Padding="5"
                                 AutomationProperties.AutomationId="AgentTargetBox"
                                 AutomationProperties.Name="Controlled agent demo URL"
                                 AutomationProperties.HelpText="For P02 validation, enter a loopback HTTP or HTTPS fixture URL." />
                        <Button x:Name="RequestAgentDemoButton"
                                Margin="0,0,0,12"
                                Content="Request agent control"
                                AutomationProperties.AutomationId="RequestAgentDemoButton"
                                AutomationProperties.Name="Request agent control for browser handoff demo"
                                Click="OnRequestAgentDemoClick" />

                        <GroupBox x:Name="AgentApprovalPanel"
                                  Margin="0,0,0,12"
                                  Header="Approval required"
                                  Visibility="Collapsed"
                                  AutomationProperties.AutomationId="AgentApprovalPanel"
                                  AutomationProperties.Name="Agent control approval required">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="AgentApprovalText"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ApproveAgentButton"
                                            MinWidth="80"
                                            Margin="0,0,8,0"
                                            Content="Approve"
                                            AutomationProperties.AutomationId="ApproveAgentButton"
                                            AutomationProperties.Name="Approve scoped agent control"
                                            Click="OnApproveAgentClick" />
                                    <Button x:Name="RejectAgentButton"
                                            MinWidth="80"
                                            Content="Reject"
                                            AutomationProperties.AutomationId="RejectAgentButton"
                                            AutomationProperties.Name="Reject agent control"
                                            Click="OnRejectAgentClick" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock x:Name="AgentUserInstruction"
                                   Margin="0,0,0,12"
                                   Text="No agent task is active."
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AgentUserInstruction"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button x:Name="TakeControlButton"
                                Margin="0,0,0,6"
                                Content="Take control"
                                IsEnabled="False"
                                AutomationProperties.AutomationId="TakeControlButton"
                                AutomationProperties.Name="Take control from agent"
                                Click="OnTakeControlClick" />
                        <Button x:Name="HandBackButton"
                                Margin="0,0,0,6"
                                Content="Hand back to agent"
                                IsEnabled="False"
                                AutomationProperties.AutomationId="HandBackButton"
                                AutomationProperties.Name="Hand control back to agent"
                                Click="OnHandBackClick" />
                        <Button x:Name="CancelAgentButton"
                                Margin="0,0,0,12"
                                Content="Cancel agent task"
                                IsEnabled="False"
                                AutomationProperties.AutomationId="CancelAgentButton"
                                AutomationProperties.Name="Cancel agent task"
                                Click="OnCancelAgentClick" />
                        <TextBlock FontWeight="SemiBold" Text="Action log" />
                        <ListBox x:Name="AgentActionLog"
                                 Height="180"
                                 Margin="0,4,0,0"
                                 AutomationProperties.AutomationId="AgentActionLog"
                                 AutomationProperties.Name="Agent action log" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
