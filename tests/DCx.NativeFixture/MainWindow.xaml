<Window x:Class="DCx.NativeFixture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCx Controlled Native App"
        Width="560"
        Height="340"
        MinWidth="480"
        MinHeight="280"
        AutomationProperties.AutomationId="NativeFixtureWindow"
        AutomationProperties.Name="DCx controlled native application">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,16"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="Controlled native application" />
        <TextBlock Grid.Row="1"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Text="This repository-owned window validates permissioned UI Automation and human handoff. It performs no external or destructive work." />
        <Label Grid.Row="2"
               Padding="0"
               Target="{Binding ElementName=FixtureInput}"
               Content="Shared text" />
        <TextBox x:Name="FixtureInput"
                 Grid.Row="3"
                 MinHeight="34"
                 Margin="0,4,0,12"
                 Padding="6"
                 AutomationProperties.AutomationId="FixtureInput"
                 AutomationProperties.Name="Shared text" />
        <StackPanel Grid.Row="4">
            <Button x:Name="ApplyButton"
                    Width="110"
                    MinHeight="34"
                    HorizontalAlignment="Left"
                    Content="Apply"
                    AutomationProperties.AutomationId="FixtureApplyButton"
                    AutomationProperties.Name="Apply shared text"
                    Click="OnApplyClick" />
            <TextBlock x:Name="ResultText"
                       Margin="0,16,0,0"
                       Text="Waiting for input."
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="FixtureResult"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
